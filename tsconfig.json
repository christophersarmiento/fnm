{
  "compilerOptions": {
    "target": "esnext",
    "moduleResolution": "NodeNext",
    "moduleDetection": "force",
    "module": "NodeNext",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"],
    "noEmit": true
  }
}
